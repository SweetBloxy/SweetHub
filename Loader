local function SelectScript(data)
    if not data.Enabled then
        Subtitle.Text = data.Name == "🪙 • Mm2 Farm"
            and "Farm disabled until source is reviewed"
            or "Coming soon"
        Tween(Subtitle, 0.15, {TextColor3 = data.Accent})
        task.delay(1.8, function()
            if Subtitle and Subtitle.Parent then
                Subtitle.Text = "Select a script"
                Tween(Subtitle, 0.2, {TextColor3 = Theme.SubText})
            end
        end)
        return
    end

    Subtitle.Text = "Loading " .. data.Name .. "..."
    Tween(Subtitle, 0.15, {TextColor3 = data.Accent})

    --// Close selector before running the selected trusted script
    Tween(Main, 0.2, {
        Size = UDim2.fromOffset(0, 0),
        BackgroundTransparency = 1
    })
    task.wait(0.22)
    ScreenGui:Destroy()

    --// Run selected script
    local success, result = pcall(function()
        assert(type(loadstring) == "function", "loadstring is unavailable in this environment")
        local source = game:HttpGet(data.Url)
        local compiled = assert(loadstring(source))
        compiled()
    end)

    if not success then
        warn("[SweetHub] Failed to load " .. data.Name .. ": " .. tostring(result))
    end
end

