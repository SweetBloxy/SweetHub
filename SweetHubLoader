--// Script selection

local function SelectScript(Data)

    if not Data.Enabled then
        return
    end

    --// Close selector

    if Gui and Gui.Parent then
        Gui:Destroy()
    end

    task.wait()

    if Data.Name == "⭐ • Mm2" then

        print("MM2 selected")

loadstring(game:HttpGet("https://raw.githubusercontent.com/SweetBloxy/SweetHub/refs/heads/main/SweetHubmm2"))()

    elseif Data.Name == "💎 • Mm2 Values" then

        print("MM2 Values selected")

loadstring(game:HttpGet("https://raw.githubusercontent.com/SweetBloxy/SweetHub/refs/heads/main/Mm2Value"))()

    elseif Data.Name == "☁️ • Wallhop" then

        print("Wallhop selected")

loadstring(game:HttpGet("https://raw.githubusercontent.com/SweetBloxy/SweetHub/refs/heads/main/SweetHubWallhop"))()

    elseif Data.Name == "🎯 • Rivals" then

        print("Rivals selected")

loadstring(game:HttpGet("https://raw.githubusercontent.com/SweetBloxy/SweetHub/refs/heads/main/SweetHubRivals"))()

    elseif Data.Name == "🪽 • Fly" then

        print("Fly selected")

loadstring(game:HttpGet("https://raw.githubusercontent.com/SweetBloxy/SweetHub/refs/heads/main/SweethubFly"))()

    end
end

