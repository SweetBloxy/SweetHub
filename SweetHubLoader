--==================================================
-- EXECUTE / SELECT
--==================================================

local function ExecuteScript(Data)

    -- Destroy selector immediately
    -- so it closes even if the selected
    -- script has an error.
    if Gui and Gui.Parent then
        Gui:Destroy()
    end

    task.wait()

    if Data.Name == "⭐ • Mm2" then

        print("MM2 selected")
loadstring(game:HttpGet("https://raw.githubusercontent.com/SweetBloxy/SweeTBloxY-Hub-mm2/refs/heads/main/SweetHubmm2"))()

    elseif Data.Name == "☁️ • Wallhop" then

        print("Wallhop selected")
loadstring(game:HttpGet("https://raw.githubusercontent.com/SweetBloxy/SweeTBloxY-Hub-mm2/refs/heads/main/SweetHubWallhop"))()

    elseif Data.Name == "🪽 • Fly" then

        print("Fly selected")
loadstring(game:HttpGet("https://raw.githubusercontent.com/SweetBloxy/SweetHub/refs/heads/main/SweethubFly"))()

    elseif Data.Name == "💎 • Mm2 Values" then

        print("MM2 Values selected")
loadstring(game:HttpGet("https://raw.githubusercontent.com/SweetBloxy/SweetHub/refs/heads/main/Mm2Value"))()
    end
end

