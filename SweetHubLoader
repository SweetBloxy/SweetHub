--// Preview State
local SelectedScript = nil

local function ClosePreview()
    Tween(PreviewScale, 0.18, {Scale = 0.75})
    Tween(Overlay, 0.18, {BackgroundTransparency = 1})

    task.delay(0.19, function()
        Overlay.Visible = false
    end)
end

local function OpenPreview(Data)
    SelectedScript = Data

    PreviewName.Text = Data.Name
    PreviewDescription.Text = Data.Description
    GameImage.Image = Data.GameImage

    Execute.Text = Data.Enabled and "EXECUTE" or "UNAVAILABLE"

    Execute.BackgroundColor3 = Data.Enabled
        and Theme.Purple
        or Theme.Surface2

    Overlay.Visible = true
    Overlay.BackgroundTransparency = 1
    PreviewScale.Scale = 0.75

    Tween(Overlay, 0.2, {
        BackgroundTransparency = 0.35
    })

    Tween(PreviewScale, 0.3, {
        Scale = 1
    })
end

PreviewClose.Activated:Connect(ClosePreview)

