--// Part Creation

local function MakePart(name, size, color, material, shape)
    local part = Instance.new("Part")
    part.Name = name
    part.Shape = shape or Enum.PartType.Ball
    part.Size = size
    part.Color = color
    part.Material = material or Enum.Material.Neon
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Parent = World

    return part
end

local function MakeOrb(name, position, diameter, color, material)
    local part = MakePart(
        name,
        Vector3.new(diameter, diameter, diameter),
        color,
        material,
        Enum.PartType.Ball
    )

    part.Position = position
    return part
end

--// Glowing Orb: NO IMAGES

local function AddOrbGlow(part, color, brightness, range)
    local light = Instance.new("PointLight")
    light.Color = color
    light.Brightness = brightness or 2
    light.Range = range or 12
    light.Shadows = false
    light.Parent = part

    return light
end

local function AddTrail(part, color, lifetime, width)
    local a0 = Instance.new("Attachment")
    a0.Position = Vector3.new(0, 0, -part.Size.Z * 0.45)
    a0.Parent = part

    local a1 = Instance.new("Attachment")
    a1.Position = Vector3.new(0, 0, part.Size.Z * 0.45)
    a1.Parent = part

    local trail = Instance.new("Trail")
    trail.Attachment0 = a0
    trail.Attachment1 = a1
    trail.Color = ColorSequence.new(color, COLORS.White)
    trail.Lifetime = lifetime or 0.45
    trail.LightEmission = 1
    trail.FaceCamera = true
    trail.MinLength = 0.05
    trail.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, width or 0.6),
        NumberSequenceKeypoint.new(1, 0)
    })
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(1, 1)
    })
    trail.Parent = part

    return trail
end

--// Impact Particles

local function MakeBurst(position, color, count, speed)
    local holder = MakeOrb(
        "StarfallParticles",
        position,
        0.2,
        color
    )

    holder.Transparency = 1

    local attachment = Instance.new("Attachment")
    attachment.Parent = holder

    local emitter = Instance.new("ParticleEmitter")
    emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    emitter.Color = ColorSequence.new(color, COLORS.White)
    emitter.LightEmission = 1
    emitter.Rate = 0
    emitter.Lifetime = NumberRange.new(0.4, 1)
    emitter.Speed = NumberRange.new(speed * 0.5, speed)
    emitter.SpreadAngle = Vector2.new(180, 180)
    emitter.Drag = 2
    emitter.RotSpeed = NumberRange.new(-180, 180)
    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.5),
        NumberSequenceKeypoint.new(1, 0)
    })
    emitter.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(1, 1)
    })
    emitter.Parent = attachment

    emitter:Emit(count)
    Debris:AddItem(holder, 2)
end

local function MakeEnergyRing(position, color, initialSize, finalSize, duration)
    local ring = MakePart(
        "EnergyRing",
        Vector3.new(0.15, initialSize, initialSize),
        color,
        Enum.Material.Neon,
        Enum.PartType.Cylinder
    )

    ring.CFrame = CFrame.new(position)
        * CFrame.Angles(0, 0, math.rad(90))

    Tween(ring, duration, {
        Size = Vector3.new(0.15, finalSize, finalSize),
        Transparency = 1
    })

    Debris:AddItem(ring, duration + 0.2)
end

