--// Showcase Each Planet For Five Seconds

for _, info in ipairs(Planets) do
    if not CameraControlled then
        break
    end

    local planet = info.Part
    local data = info.Data

    Title.Text = string.upper(data.Name)
    Subtitle.Text = "EXPLORING THE COSMOS"

    local target = planet.Position

    local offset = Vector3.new(
        planet.Size.X * 1.7 + 8,
        planet.Size.Y * 0.8 + 4,
        planet.Size.Z * 2 + 12
    )

    local elapsed = 0

    while elapsed < SHOWCASE_TIME do
        if not CameraControlled then
            break
        end

        local dt = RunService.RenderStepped:Wait()
        elapsed += dt

        local angle = elapsed * 0.12

        local cameraPosition = target + Vector3.new(
            math.cos(angle) * offset.X,
            offset.Y + math.sin(angle * 1.5) * 1.5,
            math.sin(angle) * offset.Z
        )

        Camera.CFrame = CFrame.lookAt(
            cameraPosition,
            planet.Position
        )

        Camera.FieldOfView = 55
    end
end

