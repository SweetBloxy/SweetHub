--// Animate Solar System and Orbiting Orbs

local EffectStart = os.clock()

Connect(RunService.RenderStepped:Connect(function(dt)
    if not Running then
        return
    end

    local elapsed = os.clock() - StartTime

    -- Sun pulse

    if Sun.Parent then
        local pulse = 1 + math.sin(elapsed * 1.6) * 0.045
        Sun.Size = Vector3.new(15, 15, 15) * pulse

        SunCorona.Size = Vector3.new(21, 21, 21)
            * (1 + math.sin(elapsed * 1.2) * 0.06)
    end

    -- Planet orbits

    for _, info in ipairs(Planets) do
        local data = info.Data

        info.Angle += dt * data.Speed * 0.15

        local distance = data.Distance

        local position = SolarCenter + Vector3.new(
            math.cos(info.Angle) * distance,
            math.sin(info.Angle * 0.5) * distance * 0.025,
            math.sin(info.Angle) * distance
        )

        info.Part.Position = position
        info.Glow.Position = position

        if info.Ring then
            info.Ring.CFrame = CFrame.new(position)
                * CFrame.Angles(
                    math.rad(22),
                    0,
                    math.rad(90)
                )
        end

        if info.Bands then
            for _, band in ipairs(info.Bands) do
                band.CFrame = info.Part.CFrame
                    * CFrame.Angles(
                        math.rad(94),
                        0,
                        math.rad(90)
                    )
            end
        end
    end

    -- Distant star twinkle

    for _, info in ipairs(BackgroundStars) do
        if info.Part.Parent then
            local twinkle = math.sin(
                elapsed * 2 + info.Phase
            ) * 0.12

            info.Part.Transparency = math.clamp(
                0.4 + twinkle,
                0.1,
                0.75
            )
        end
    end

    -- Three separate movement patterns

    if Root.Parent then
        local center = Root.Position

        for _, info in ipairs(OrbitStars) do
            local star = info.Part
            local config = info.Config

            if star.Parent then
                local angle = elapsed * config.Speed
            + config.Phase

                local x, y, z

                if config.Pattern == 1 then
                    x = math.cos(angle) * config.Radius
                    y = math.sin(angle * 1.3) * config.Height
                    z = math.sin(angle) * config.Radius * 0.65

                elseif config.Pattern == 2 then
                    x = math.cos(angle) * config.Radius
                    y = -math.sin(angle * 1.2) * config.Height
                    z = math.sin(angle) * config.Radius * 0.65

                else
                    x = math.sin(angle * 0.8)
                        * config.Radius * 0.6

                    y = math.sin(angle * 1.5)
                        * config.Height

                    z = math.cos(angle) * config.Radius
                end

                star.Position = center + Vector3.new(
                    x,
                    y + 1.6,
                    z
                )
            end
        end
    end
end))

