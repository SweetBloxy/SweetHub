local function AddItem(name, value, rarityColor)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1,-8,0,46)
    Row.BackgroundColor3 = Color3.fromRGB(32,32,41)
    Row.BorderSizePixel = 0
