    Rarity.Position = UDim2.new(0.77,0,0,0)
    Rarity.BackgroundTransparency = 1
    Rarity.Text = ActiveCategory:gsub("^%S+%s*","")
    Rarity.TextColor3 = rarityColor
    Rarity.TextSize = 10
    Rarity.Font = Enum.Font.GothamBold
    Rarity.TextXAlignment = Enum.TextXAlignment.Right
    Rarity.Parent = Row
end

local function Refresh()
    ClearList()

    local category = Categories[ActiveCategory]
    if not category then return end

    local query = string.lower(Search.Text or "")

    for _, item in ipairs(category.Data) do
        local name = tostring(item[1])
        if query == "" or string.find(string.lower(name), query, 1, true) then
            AddItem(name, item[2], category.Color)
        end
    end
end

local function SelectCategory(name, button)
    ActiveCategory = name

    for _, child in ipairs(SideScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child.BackgroundColor3 = Color3.fromRGB(38,38,48)
        end
    end

    button.BackgroundColor3 = Color3.fromRGB(55,55,70)
    Search.Text = ""
    Refresh()
end

for name, info in pairs(Categories) do
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1,-8,0,36)
    Button.BackgroundColor3 = Color3.fromRGB(38,38,48)
    Button.BorderSizePixel = 0
    Button.Text = name
    Button.TextColor3 = info.Color
    Button.TextSize = 11
    Button.Font = Enum.Font.GothamBold
    Button.Parent = SideScroll
    Corner(Button,8)

    Button.Activated:Connect(function()
        SelectCategory(name, Button)
    end)
end

