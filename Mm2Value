--==================================================
-- AUTO UPDATE SETTINGS
--==================================================
-- Put your JSON database URL here.
-- Leave blank to use the built-in values.
local REMOTE_VALUES_URL = ""

local function ApplyRemoteValues()
    if REMOTE_VALUES_URL == "" then return false end

    local ok, raw = pcall(function()
        return game:HttpGet(REMOTE_VALUES_URL)
    end)
    if not ok then return false end

    local ok2, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(raw)
    end)
    if not ok2 or type(data) ~= "table" then return false end

    local map = {
        Godlies="💗 Godlies", Vintages="🟡 Vintages",
        Ancients="💜 Ancients", Croma="🌈 Croma",
        Legendaries="❤️ Legendaries", Rares="🔵 Rares",
        Uncommons="🟣 Uncommons", Commons="⚪ Commons"
    }

    for remoteName, categoryName in pairs(map) do
        if type(data[remoteName]) == "table" then
            local newData = {}
            for _, item in ipairs(data[remoteName]) do
                if type(item) == "table" and item[1] ~= nil and item[2] ~= nil then
                    table.insert(newData, {tostring(item[1]), item[2]})
                end
            end
            Categories[categoryName].Data = newData
        end
    end
    return true
end

