    Value.TextColor3 = Color3.fromRGB(255,210,70)
    Value.TextSize = 11
    Value.Font = Enum.Font.GothamBold
    Value.TextXAlignment = Enum.TextXAlignment.Center
    Value.TextTruncate = Enum.TextTruncate.AtEnd
    Value.Parent = Row

    local Rarity = Instance.new("TextLabel")
