local function RefreshPlayerList()
	for _, child in ipairs(PlayerList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do

		if player ~= LocalPlayer then

			local button = Instance.new("TextButton")
			button.Size = UDim2.new(1, -2, 0, 28)

			local excluded =
				IsExcluded(player)

			button.BackgroundColor3 =
				excluded
				and C.RED
				or C.SURFACE2

			button.Text =
				excluded
				and player.DisplayName .. "  [X]"
				or player.DisplayName

			button.TextSize = 10
			button.Font = Enum.Font.GothamMedium
			button.TextColor3 = C.WHITE
			button.AutoButtonColor = false
			button.ZIndex = 22
			button.Parent = PlayerList

			Corner(button, 6)

			button.MouseButton1Click:Connect(function()

				EXCLUDED[player] =
					not EXCLUDED[player]

				Notify(
					player.DisplayName
					.. (
						EXCLUDED[player]
						and " excluded"
						or " included"
					)
				)

				RefreshPlayerList()
			end)
		end
	end

	task.defer(function()
		PlayerList.CanvasSize =
			UDim2.fromOffset(
				0,
				PlayerLayout.AbsoluteContentSize.Y + 5
			)
	end)
end

ExcludeAll.MouseButton1Click:Connect(function()

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			EXCLUDED[player] = true
		end
	end

	RefreshPlayerList()
	Notify("All players excluded")
end)

IncludeAll.MouseButton1Click:Connect(function()

	table.clear(EXCLUDED)

	RefreshPlayerList()
	Notify("All players included")
end)

ExcludeButton.MouseButton1Click:Connect(function()
	ExcludePanel.Visible = not ExcludePanel.Visible

	if ExcludePanel.Visible then
		RefreshPlayerList()
	end
end)

