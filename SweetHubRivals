local Shortcuts = {}

local ShortcutData = {
	{
		Name = "Aimbot",
		Short = "A",
		Color = C.ACCENT
	},
	{
		Name = "ESP",
		Short = "E",
		Color = C.GREEN
	},
	{
		Name = "Wallcheck",
		Short = "W",
		Color = C.YELLOW
	},
	{
		Name = "Strong",
		Short = "S",
		Color = C.RED
	},
	{
		Name = "Aim Part",
		Short = "P",
		Color = C.ACCENT
	}
}

local function ShortcutState(name)
	if name == "Aimbot" then
		return AIMBOT_ENABLED
	elseif name == "ESP" then
		return ESP_ENABLED
	elseif name == "Wallcheck" then
		return WALLCHECK
	elseif name == "Strong" then
		return STRONG_LOCK
	end

	return false
end

local function ToggleShortcut(name)

	if name == "Aimbot" then
		SetAimbot(not AIMBOT_ENABLED)

	elseif name == "ESP" then

		ESP_ENABLED = not ESP_ENABLED
		SetButton(ESPButton, ESP_ENABLED)

		if not ESP_ENABLED then
			for _, data in pairs(ESPObjects) do
				data.Box.Visible = false
				data.Outline.Visible = false
			end
		end

		Notify(
			"ESP "
			.. (ESP_ENABLED and "Enabled" or "Disabled")
		)

	elseif name == "Wallcheck" then

		WALLCHECK = not WALLCHECK
		SetButton(WallButton, WALLCHECK)

		Notify(
			"Wallcheck "
			.. (WALLCHECK and "Enabled" or "Disabled")
		)

	elseif name == "Strong" then

		STRONG_LOCK = not STRONG_LOCK
		SetButton(StrongButton, STRONG_LOCK)

		Notify(
			"Strong Lock "
			.. (STRONG_LOCK and "Enabled" or "Disabled")
		)

	elseif name == "Aim Part" then

		if AIM_PART == "Head" then
			AIM_PART = "HumanoidRootPart"
			AimPartButton.Text = "Aim: HRP"
		else
			AIM_PART = "Head"
			AimPartButton.Text = "Aim: Head"
		end

		Notify(
			"Aim: "
			.. (AIM_PART == "Head" and "Head" or "HRP")
		)
	end
end

local function UpdateShortcutVisual(name, button)

	local enabled = ShortcutState(name)

	Tween(button, 0.12, {
		BackgroundColor3 =
			enabled
			and C.GREEN
			or C.SURFACE,

		TextColor3 =
			enabled
			and C.BLACK
			or C.WHITE
	}):Play()
end

for index, info in ipairs(ShortcutData) do

	local button = Instance.new("TextButton")

	button.Name = info.Name
	button.Size = UDim2.fromOffset(105, 36)

	button.Position =
