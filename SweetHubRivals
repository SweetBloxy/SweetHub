--==================================================
-- SHORTCUT DRAG
--==================================================

local ShortcutDragging = {}
local ShortcutDragStart = {}
local ShortcutStartPosition = {}

for name, button in pairs(Shortcuts) do

	button.InputBegan:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			ShortcutDragging[name] = true
			ShortcutDragStart[name] = input.Position
			ShortcutStartPosition[name] = button.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					ShortcutDragging[name] = false
				end
			end)
		end
	end)
end

UserInputService.InputChanged:Connect(function(input)

	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	for name, button in pairs(Shortcuts) do

		if ShortcutDragging[name] then

			local delta =
				input.Position
				- ShortcutDragStart[name]

			button.Position = UDim2.new(
				ShortcutStartPosition[name].X.Scale,
				ShortcutStartPosition[name].X.Offset + delta.X,

				ShortcutStartPosition[name].Y.Scale,
				ShortcutStartPosition[name].Y.Offset + delta.Y
			)
		end
	end
end)

--==================================================
-- HOLD SHORTCUT HANDLE = HIDE
-- TAP = SHOW
--==================================================

local HandleHolding = false
local HandleHoldStart = 0
local HandleMoved = false

ShortcutHandle.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		HandleHolding = true
		HandleHoldStart = os.clock()
		HandleMoved = false

		task.delay(0.45, function()

			if HandleHolding and not HandleMoved then

				ShortcutHolder.Visible =
					not ShortcutHolder.Visible

				Notify(
					ShortcutHolder.Visible
					and "Shortcuts Shown"
					or "Shortcuts Hidden"
				)
			end
		end)

		input.Changed:Connect(function()

			if input.UserInputState == Enum.UserInputState.End then
				HandleHolding = false
			end
		end)
	end
end)

--==================================================
-- DRAG SHORTCUT HANDLE
--==================================================

local HandleDragging = false
local HandleDragStart
local HandleStartPosition

ShortcutHandle.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		HandleDragging = true
		HandleDragStart = input.Position
		HandleStartPosition = ShortcutHandle.Position

		input.Changed:Connect(function()

			if input.UserInputState == Enum.UserInputState.End then
				HandleDragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)

	if not HandleDragging then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local delta =
		input.Position - HandleDragStart

	if math.abs(delta.X) > 4
		or math.abs(delta.Y) > 4 then

		HandleMoved = true
	end

	ShortcutHandle.Position = UDim2.new(
		HandleStartPosition.X.Scale,
		HandleStartPosition.X.Offset + delta.X,

		HandleStartPosition.Y.Scale,
		HandleStartPosition.Y.Offset + delta.Y
	)
end)

