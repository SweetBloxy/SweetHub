-- ESP
--==================================================

local ESPObjects = {}

local function RemoveESP(player)
	local data = ESPObjects[player]

	if not data then
		return
	end

	if data.Box then
		data.Box:Destroy()
	end

	if data.Outline then
		data.Outline:Destroy()
	end

	ESPObjects[player] = nil
end

local function CreateESP(player)
	if player == LocalPlayer then
		return
	end

	if ESPObjects[player] then
		return
	end

	local box = Instance.new("BoxHandleAdornment")
	box.Name = "SweetHubESP"
	box.Size = Vector3.new(4, 6, 2)
	box.Color3 = C.ACCENT
	box.Transparency = 0.55
	box.AlwaysOnTop = true
	box.ZIndex = 5
	box.Visible = false
	box.Parent = workspace

	local outline = Instance.new("BoxHandleAdornment")
	outline.Name = "SweetHubESPOutline"
	outline.Size = Vector3.new(4.2, 6.2, 2.2)
	outline.Color3 = C.WHITE
	outline.Transparency = 0.85
	outline.AlwaysOnTop = true
	outline.ZIndex = 4
	outline.Visible = false
	outline.Parent = workspace

	ESPObjects[player] = {
		Box = box,
		Outline = outline
	}
end

local function UpdateESP(player)
	local data = ESPObjects[player]

	if not data then
		return
	end

	if not ESP_ENABLED or IsExcluded(player) then
		data.Box.Visible = false
		data.Outline.Visible = false
		return
	end

	local character = GetCharacter(player)

	if not character then
		data.Box.Visible = false
		data.Outline.Visible = false
		return
	end

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	local myCharacter =
		GetCharacter(LocalPlayer)

	local myRoot =
		myCharacter and
		myCharacter:FindFirstChild("HumanoidRootPart")

	if not myRoot then
		return
	end

	local distance =
		(root.Position - myRoot.Position).Magnitude

	if distance > ESP_DISTANCE then
		data.Box.Visible = false
		data.Outline.Visible = false
		return
	end

	data.Box.Adornee = root
	data.Outline.Adornee = root

	data.Box.Visible = true
	data.Outline.Visible = true
end

for _, player in ipairs(Players:GetPlayers()) do
	if player ~= LocalPlayer then
		CreateESP(player)
	end
end

Players.PlayerAdded:Connect(function(player)
	CreateESP(player)
end)

Players.PlayerRemoving:Connect(function(player)
	RemoveESP(player)
	EXCLUDED[player] = nil
end)

task.spawn(function()
	while Gui.Parent do

		if ESP_ENABLED then
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer then

					if not ESPObjects[player] then
						CreateESP(player)
					end

					UpdateESP(player)
				end
			end
		end

		task.wait(0.06)
	end
end)

