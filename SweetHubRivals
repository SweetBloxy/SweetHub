local function SetAimbot(enabled, silent)
	AIMBOT_ENABLED = enabled

	SetButton(AimbotButton, enabled)

	if Circle then
		Circle.Visible = enabled
	end

	if not enabled then
		CURRENT_TARGET = nil
		AimedLabel.Text = "Aimed: None"
	end

	if not silent then
		Notify(
			"Aimbot "
			.. (enabled and "Enabled" or "Disabled")
		)
	end
end

RunService:BindToRenderStep(
	"SweetHub_Aimbot",
	Enum.RenderPriority.Camera.Value + 1,
	function()

		if not AIMBOT_ENABLED then
			return
		end

		local camera = workspace.CurrentCamera

		if not camera then
			return
		end

		CURRENT_TARGET = FindTarget()

		if not CURRENT_TARGET then
			AimedLabel.Text = "Aimed: None"
			return
		end

		local character =
			GetCharacter(CURRENT_TARGET)

		if not character then
			CURRENT_TARGET = nil
			return
		end

		local aimPart =
			GetAimPart(character)

		if not aimPart then
			return
		end

		AimedLabel.Text =
			"Aimed: " .. CURRENT_TARGET.DisplayName

		local goal =
			CFrame.new(
				camera.CFrame.Position,
				aimPart.Position
			)

		if STRONG_LOCK then
			camera.CFrame = goal
		else
			camera.CFrame =
				camera.CFrame:Lerp(
					goal,
					AIM_SMOOTHNESS
				)
		end
	end
)

